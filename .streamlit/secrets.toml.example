# SALIN isi ini ke Secrets Streamlit Cloud (atau .streamlit/secrets.toml untuk lokal).
# JANGAN commit file secrets.toml ke GitHub. Buat hash dengan:  python hash_password.py
[auth]
session_minutes = 30

[auth.users.admin]
name = "Administrator"
role = "Admin"
salt = "ISI_DARI_hash_password.py"
hash = "ISI_DARI_hash_password.py"

[auth.users.personel1]
name = "Personel 1"
role = "Personel"
salt = "ISI_DARI_hash_password.py"
hash = "ISI_DARI_hash_password.py"
